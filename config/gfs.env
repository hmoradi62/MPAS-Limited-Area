# GFS cycle
: "${CYCLE:=20261031}"
: "${CYCLE_HOUR:=00}"

# Forecast range (hours)
: "${START_FH:=0}"
: "${END_FH:=48}"
: "${STEP_H:=3}"

# Geographic domain
: "${LEFTLON:=20}"
: "${RIGHTLON:=82}"
: "${TOPLAT:=60}"
: "${BOTTOMLAT:=5}"

# Output directory
: "${OUTDIR:=Data_GFS_${CYCLE}_${CYCLE_HOUR}}"
